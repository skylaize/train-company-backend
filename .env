# Connexion utilisée par le jeu. En production (Neon), c'est l'adresse avec
# "-pooler" dans le nom d'hôte : le connecteur mutualisé encaisse les requêtes
# courtes et nombreuses de la simulation.
DATABASE_URL="postgresql://app_reseau:vbGpZlIVBJHR8Mgq@141.94.16.41:5432/prod_bdd?sslmode=disable"

# Connexion utilisée UNIQUEMENT par les migrations : la même base, sans le
# pooler. Le moteur de migration a besoin d'une vraie session, que PgBouncer en
# mode transaction ne sait pas tenir — à travers le pooler, "migrate deploy"
# expire en P1002. En local, mettez simplement la même valeur que ci-dessus.
DIRECT_DATABASE_URL="postgresql://app_reseau:vbGpZlIVBJHR8Mgq@141.94.16.41:5432/prod_bdd?sslmode=disable"