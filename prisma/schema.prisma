generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connexion du jeu : elle passe par le connecteur mutualisé de Neon
  // (l'hôte en "-pooler"), qui encaisse sans broncher les requêtes courtes et
  // nombreuses de la simulation.
  url = env("DATABASE_URL")
  // Connexion des migrations : la même base, mais SANS le pooler. Le moteur de
  // migration a besoin d'une vraie session — verrous consultatifs, transactions
  // longues — que PgBouncer en mode transaction ne sait pas tenir. À travers le
  // pooler, "migrate deploy" finit en P1002 alors que le jeu, lui, fonctionne.
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  pseudo    String
  password  String
  createdAt DateTime @default(now())

  company   Company?
}

model Company {
  id           String   @id @default(uuid())
  name         String
  liveryColor  String   @default("#f2a900")
  balance      Int      @default(500) // trésorerie, en pièces
  maxTrains    Int      @default(2) // capacité du dépôt, extensible contre paiement
  isPremium    Boolean  @default(false) // débloque les modèles de trains exclusifs
  tutorialSeen Boolean  @default(false) // mémorisé côté compte, pas par navigateur
  theme        String   @default("sombre") // "sombre" | "papier", suit le joueur d'un appareil à l'autre
  lastSeenVersion String? // dernier bulletin de nouveautés lu, mémorisé sur le compte et non par navigateur
  hintsSeen    String   @default("") // ids des explications déjà lues, séparés par des virgules
  referralCode String   @unique // code à partager, généré à la création
  referredById String?  // compagnie qui a parrainé celle-ci, si un code a été renseigné à l'inscription
  referralRewardGranted Boolean @default(false) // évite de verser deux fois la récompense au parrain
  referralMilestone Int  @default(0) // plus haut palier de parrainage déjà accordé (3, 5, 10 filleuls)
  title        String?  // titre affiché au classement : gagné (palier 5) ou choisi parmi ceux de la boutique
  emblem       String?  // emblème porté devant le nom de la compagnie, choisi parmi ceux débloqués
  // Bilan de retour (Premium) : dernière activité connue, et fenêtre d'absence à résumer
  lastActiveAt       DateTime?
  lastActiveBalance  Int?
  absenceFrom        DateTime?
  absenceTo          DateTime?
  absenceFromBalance Int?
  absenceToBalance   Int?
  lastDigestOn       String? // jour (AAAA-MM-JJ, heure de Paris) du dernier bilan du matin envoyé
  createdAt    DateTime @default(now())

  owner        User     @relation(fields: [ownerId], references: [id])
  ownerId      String   @unique

  referredBy   Company? @relation("Referrals", fields: [referredById], references: [id])
  referrals    Company[] @relation("Referrals")

  trains       Train[]
  lines        Line[]
  contracts    Contract[]
  transactions Transaction[]
  dailyChallenges DailyChallenge[]
  staff        Staff[]
  achievementUnlocks AchievementUnlock[]
  adWatches    AdWatch[]
  clientRelations ClientRelation[]
  missions     Mission[]
  warehouse    Warehouse?
  stockLots    StockLot[]
  constructions Construction[]
  priceAlerts  PriceAlert[]
  standingOrders StandingOrder[]
  pushSubscriptions PushSubscription[]
  shopPurchases ShopPurchase[]
}

// Un objet cosmétique acheté. Une ligne par objet et par compagnie : on ne
// vend chaque objet qu'une fois. La session Stripe sert de preuve de paiement
// et de garde contre un webhook livré deux fois.
model ShopPurchase {
  id              String   @id @default(uuid())
  itemId          String
  stripeSessionId String   @unique
  amountCents     Int
  purchasedAt     DateTime @default(now())

  company         Company  @relation(fields: [companyId], references: [id])
  companyId       String

  @@unique([companyId, itemId])
}

// Un appareil abonné aux notifications. Une compagnie peut en avoir plusieurs :
// le téléphone et l'ordinateur sont deux abonnements distincts, chacun avec ses
// propres clés de chiffrement. L'endpoint est l'identifiant unique côté
// navigateur — c'est lui qui sert de clé, pas l'appareil.
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
  companyId String

  @@index([companyId])
}

// ============================================================
// Cours du fret.
//
// Une seule ligne par marchandise, partagée par tout le réseau : le cours est
// une donnée de monde, pas de compagnie. Tout le monde voit le même prix au
// même moment, sinon spéculer n'aurait aucun sens collectif.
// ============================================================
model CargoMarket {
  cargoType String   @id // clé naturelle : le nom de la marchandise, déjà utilisé partout ailleurs
  basePrice Int      // valeur de référence d'une unité, autour de laquelle le cours oscille
  index     Float    @default(1) // multiplicateur courant, borné (voir market.service)
  history   String   @default("[]") // derniers relevés, JSON [{t,i}] — suffisant pour tracer une courbe
  eventLabel String? // événement en cours qui explique le mouvement, affiché tel quel au joueur
  eventUntil DateTime?
  updatedAt DateTime @updatedAt
}

// Entrepôt de la compagnie : ce qui permet de garder de la marchandise au lieu
// de la livrer tout de suite. Construit par chantier, agrandi par chantier.
model Warehouse {
  id        String   @id @default(uuid())
  capacity  Int      @default(20) // unités stockables, toutes marchandises confondues
  level     Int      @default(1)  // nombre d'agrandissements effectués, pilote le coût du suivant
  builtAt   DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
  companyId String   @unique
}

// Un lot en stock. Le prix d'achat moyen est conservé pour pouvoir afficher la
// plus ou moins-value : sans lui, le joueur ne sait pas s'il gagne de l'argent.
model StockLot {
  id           String   @id @default(uuid())
  cargoType    String
  quantity     Int
  avgUnitPrice Float    // moyenne pondérée des achats successifs

  company      Company  @relation(fields: [companyId], references: [id])
  companyId    String

  @@unique([companyId, cargoType])
}

// Chantier en cours. Une seule ligne active par compagnie : c'est la règle qui
// empêche une grosse trésorerie de se convertir instantanément en progression.
model Construction {
  id        String   @id @default(uuid())
  kind      String   // DEPOT | ENTREPOT | ENTREPOT_AGRANDISSEMENT
  label     String   // libellé figé à la commande, pour l'afficher sans le recalculer
  cost      Int      // déjà débité à la commande : on paie le chantier, pas la livraison
  startedAt DateTime @default(now())
  endsAt    DateTime
  done      Boolean  @default(false)
  queued    Boolean  @default(false) // en file (Premium) : démarre à la fin du chantier en cours
  durationMs Int     @default(0) // durée prévue, pour recaler endsAt au démarrage réel

  company   Company  @relation(fields: [companyId], references: [id])
  companyId String

  @@index([companyId, done])
}

// Alerte de cours (abonnés). Purement informative : elle ne fait rien d'autre
// que prévenir, donc elle enlève la surveillance, pas le travail.
model PriceAlert {
  id          String   @id @default(uuid())
  cargoType   String
  direction   String   // DESSOUS | DESSUS
  threshold   Float    // seuil exprimé en indice (1 = cours normal)
  triggeredAt DateTime?
  seen        Boolean  @default(false)
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String

  @@index([companyId])
}

// Ordre permanent (abonnés) : achète ou vend automatiquement au franchissement
// d'un seuil. Le prix obtenu est exactement celui qu'aurait eu un joueur
// présent — c'est la présence qui est remplacée, pas le rendement.
model StandingOrder {
  id         String   @id @default(uuid())
  cargoType  String
  kind       String   // ACHAT | VENTE
  threshold  Float
  quantity   Int
  active     Boolean  @default(true)
  lastRunAt  DateTime?
  createdAt  DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String

  @@index([companyId, active])
}

// Relation commerciale avec un donneur d'ordre. La réputation gagnée ici
// majore le tarif de TOUTES les cargaisons de ce client, pas seulement
// celles livrées dans le cadre d'une mission.
model ClientRelation {
  id         String   @id @default(uuid())
  clientId   String   // ACIERIES | PORT | COOPERATIVE | LABORATOIRES
  reputation Int      @default(0) // 0 à 100
  level      Int      @default(0) // palier atteint, pour ne le fêter qu'une fois

  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String

  @@unique([companyId, clientId])
}

// Un ordre daté proposé par un donneur d'ordre : le joueur l'accepte ou le refuse.
model Mission {
  id         String   @id @default(uuid())
  clientId   String
  cargoType  String   // marchandise demandée, tirée parmi celles du client
  target     Int      // nombre de cargaisons à livrer
  progress   Int      @default(0)
  reward     Int      // pièces versées à la réussite
  repReward  Int      // réputation gagnée chez ce client
  status     String   @default("PROPOSEE") // PROPOSEE | ACCEPTEE | REUSSIE | ECHOUEE
  offerUntil DateTime // au-delà, l'offre expire et le client en propose une autre
  dueAt      DateTime? // échéance de livraison, fixée à l'acceptation
  createdAt  DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String

  @@index([companyId, status])
}

model AdWatch {
  id        String   @id @default(uuid())
  date      String   // format "AAAA-MM-JJ", un enregistrement par jour et par compagnie
  count     Int      @default(0)

  company   Company  @relation(fields: [companyId], references: [id])
  companyId String

  @@unique([companyId, date])
}

model AchievementUnlock {
  id            String   @id @default(uuid())
  achievementId String   // identifiant du succès (ex. "coffres-pleins"), pas une relation, juste une clé fixe
  unlockedAt    DateTime @default(now())

  company       Company  @relation(fields: [companyId], references: [id])
  companyId     String

  @@unique([companyId, achievementId])
}

model Line {
  id                String   @id @default(uuid())
  name              String
  departureStation  String
  arrivalStation    String
  durationMinutes   Int      // temps de trajet simulé, en minutes

  company           Company  @relation(fields: [companyId], references: [id])
  companyId         String

  trains            Train[]

  createdAt         DateTime @default(now())
}

enum TrainStatus {
  IDLE          // à quai, disponible pour une ligne ou un contrat de fret
  EN_ROUTE      // en circulation (ligne voyageurs ou livraison de fret)
  MAINTENANCE   // indisponible
}

model Train {
  id           String      @id @default(uuid())
  name         String
  model        String      @default("STANDARD") // STANDARD | EXPRESS | FRET_LOURD (Premium)
  status       TrainStatus @default(IDLE)

  // progression du trajet en cours (0 = départ, 100 = arrivé)
  progress     Int         @default(0)
  departedAt   DateTime?

  // usure du matériel (0 = neuf, 100 = en panne, nécessite réparation)
  wear         Int         @default(0)

  company      Company     @relation(fields: [companyId], references: [id])
  companyId    String

  line         Line?       @relation(fields: [lineId], references: [id])
  lineId       String?

  contract     Contract?

  incidents    Incident[]

  purchasedAt  DateTime    @default(now())
}

enum ContractStatus {
  DISPONIBLE  // offre sur le marché, pas encore prise
  EN_COURS    // acceptée, un train livre la marchandise
  LIVREE      // terminée, récompense versée
}

model Contract {
  id                String         @id @default(uuid())
  cargoType         String         // type de marchandise transportée
  originStation     String
  destinationStation String
  durationMinutes   Int            // temps de livraison simulé
  reward            Int            // récompense versée à la livraison
  risky             Boolean        @default(false) // marchandise fragile : récompense plus élevée mais risque de dommage
  insured           Boolean        @default(false) // prime payée à l'acceptation pour réduire le risque de dommage

  status            ContractStatus @default(DISPONIBLE)
  acceptedAt        DateTime?
  expiresAt         DateTime?      // au-delà, l'offre disparaît du marché si non acceptée

  company           Company?       @relation(fields: [companyId], references: [id])
  companyId         String?

  train             Train?         @relation(fields: [trainId], references: [id])
  trainId           String?        @unique

  createdAt         DateTime       @default(now())
}

model Incident {
  id          String   @id @default(uuid())
  message     String

  train       Train    @relation(fields: [trainId], references: [id])
  trainId     String

  createdAt   DateTime @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  type        String   // ACHAT_TRAIN | REPARATION | FRET | FONDATION | PERSONNEL | REVENU_LIGNE | PARRAINAGE | PUBLICITE
  amount      Int      // positif = recette, négatif = dépense
  description String
  // rame et ligne concernées, pour la rentabilité détaillée (sans clé étrangère :
  // une rame vendue ou une ligne supprimée ne doit pas effacer l'historique)
  trainId     String?
  lineId      String?

  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String

  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
}

model DailyChallenge {
  id        String   @id @default(uuid())
  date      String   // "YYYY-MM-DD", jour auquel ce défi appartient
  type      String   // LIVRAISONS | REPARATIONS | NOUVELLE_LIGNE
  target    Int
  reward    Int
  claimed   Boolean  @default(false)

  company   Company  @relation(fields: [companyId], references: [id])
  companyId String

  createdAt DateTime @default(now())

  @@unique([companyId, date])
}

model Staff {
  id             String   @id @default(uuid())
  role           String   // MECANICIEN | CHEF_DEPOT | DIRECTEUR_COMMERCIAL
  name           String   @default("")
  level          Int      @default(1)    // 1 à 5, accordé par le joueur à chaque augmentation
  xp             Int      @default(0)    // ticks de service : c'est l'ancienneté qui fait l'expérience
  raiseRequested Boolean  @default(false) // l'employé a atteint le niveau suivant et attend une réponse
  refusedAtXp    Int      @default(0)    // expérience au dernier refus, pour ne pas redemander aussitôt
  salaryPerTick  Int
  hiredAt        DateTime @default(now())

  company        Company  @relation(fields: [companyId], references: [id])
  companyId      String

  // plus d'unicité par poste : on peut désormais embaucher plusieurs mécaniciens
  @@index([companyId, role])
}

model WeatherEvent {
  id        String   @id @default(uuid())
  type      String   // BROUILLARD | CANICULE | VERGLAS
  startedAt DateTime @default(now())
  endsAt    DateTime
}
