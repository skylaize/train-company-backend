generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connexion du jeu : elle passe par le connecteur mutualisé de Neon
  // (l'hôte en "-pooler"), qui encaisse sans broncher les requêtes courtes et
  // nombreuses de la simulation.
  url = env("DATABASE_URL")
  // Connexion des migrations : la même base, mais SANS le pooler. Le moteur de
  // migration a besoin d'une vraie session — verrous consultatifs, transactions
  // longues — que PgBouncer en mode transaction ne sait pas tenir. À travers le
  // pooler, "migrate deploy" finit en P1002 alors que le jeu, lui, fonctionne.
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  pseudo    String
  password  String
  createdAt DateTime @default(now())
  // 2.1 : compte Discord lié (rôles automatiques, /profil). Null tant que le
  // joueur n'a pas cliqué sur « Lier mon Discord » dans les Paramètres.
  discordId   String? @unique
  discordName String?
  // 2.3 : boost Nitro du serveur Discord. boostSince = début du boost en cours
  // (premium_since de Discord), boostDays = jours de boost des fois précédentes.
  boostSince DateTime?
  boostDays  Int       @default(0)
  // 2.2 : compte suspendu depuis le panneau d'administration (toute l'API lui répond 403)
  bannedAt     DateTime?
  bannedReason String?

  company   Company?
  passwordResets PasswordReset[]
}

// Mot de passe oublié (1.6) : lien à usage unique, valable une heure. Seule
// l'empreinte du jeton est gardée : une fuite de la base ne donne aucun lien.
model PasswordReset {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
}

model Company {
  id           String   @id @default(uuid())
  name         String
  liveryColor  String   @default("#f2a900")
  balance      Int      @default(500) // trésorerie, en pièces
  maxTrains    Int      @default(2) // capacité du dépôt, extensible contre paiement
  isPremium    Boolean  @default(false) // débloque les modèles de trains exclusifs
  // 2.1 : Premium d'essai offert par le staff (/donner, /giveaway). Pendant
  // l'essai isPremium vaut true ; à cette date il repasse à false, sauf achat.
  premiumTrialUntil   DateTime?
  premiumTrialEndedAt DateTime? // fin du dernier essai : le jeu propose alors de garder le Premium
  premiumReveal String? // 2.0 : animation Premium à montrer ("" = acheté soi-même, sinon nom de qui l'offre)
  tutorialSeen Boolean  @default(false) // mémorisé côté compte, pas par navigateur
  tutorialRewards String[] @default([]) // 2.0.3 : primes de stage déjà versées (ligne, service, carte, prix)
  // 2.1 : les sons de gare, l'habillage des gares en vue cabine, les tenues du personnel
  soundPack    String?
  stationSkin  String?
  uniform      String?
  theme        String   @default("sombre") // "sombre" | "papier", suit le joueur d'un appareil à l'autre
  lastSeenVersion String? // dernier bulletin de nouveautés lu, mémorisé sur le compte et non par navigateur
  hintsSeen    String   @default("") // ids des explications déjà lues, séparés par des virgules
  referralCode String   @unique // code à partager, généré à la création
  referredById String?  // compagnie qui a parrainé celle-ci, si un code a été renseigné à l'inscription
  referralRewardGranted Boolean @default(false) // évite de verser deux fois la récompense au parrain
  referralMilestone Int  @default(0) // plus haut palier de parrainage déjà accordé (3, 5, 10 filleuls)
  title        String?  // titre affiché au classement : gagné (palier 5) ou choisi parmi ceux de la boutique
  emblem       String?  // emblème porté devant le nom de la compagnie, choisi parmi ceux débloqués
  plate        String?  // 1.7.1 : plaque d'honneur portée au classement (laiton, email, or)
  division     Int      @default(0) // 2.0 : division de saison (0 Bronze, 1 Argent, 2 Or, 3 Platine)
  cabSkin      String?  // matériel de collection affiché dans la vue cabine (1.4), choisi parmi ceux achetés
  intlLicenceAt DateTime? // licence internationale (1.6) : date d'achat, null tant qu'elle n'est pas achetée
  partsStock   Json     @default("{}") // 2.0 : pièces détachées en stock au magasin { FREINS: 2, … }
  reputationAdjust Int  @default(0) // décisions (1.6) : points gagnés ou perdus, ajoutés à la réputation calculée
  nextDecisionAt DateTime? // décisions (1.6) : pas de nouvelle décision avant cette heure
  // Bilan de retour (Premium) : dernière activité connue, et fenêtre d'absence à résumer
  lastActiveAt       DateTime?
  lastActiveBalance  Int?
  absenceFrom        DateTime?
  absenceTo          DateTime?
  absenceFromBalance Int?
  absenceToBalance   Int?
  lastDigestOn       String? // jour (AAAA-MM-JJ, heure de Paris) du dernier bilan du matin envoyé
  // 2.1.2 : numéro de pionnier, figé à la migration (les 200 premières compagnies)
  pioneerNumber Int?    @unique
  createdAt    DateTime @default(now())

  owner        User     @relation(fields: [ownerId], references: [id])
  ownerId      String   @unique

  referredBy   Company? @relation("Referrals", fields: [referredById], references: [id])
  referrals    Company[] @relation("Referrals")

  trains       Train[]
  lines        Line[]
  contracts    Contract[]
  transactions Transaction[]
  dailyChallenges DailyChallenge[]
  staff        Staff[]
  achievementUnlocks AchievementUnlock[]
  adWatches    AdWatch[]
  clientRelations ClientRelation[]
  missions     Mission[]
  warehouse    Warehouse?
  stockLots    StockLot[]
  constructions Construction[]
  priceAlerts  PriceAlert[]
  standingOrders StandingOrder[]
  pushSubscriptions PushSubscription[]
  shopPurchases ShopPurchase[]
  tenderBids   TenderBid[]
  decisions    Decision[]
  // 1.7 : infrastructures, emprunts, bourse
  stationsOwned StationOwnership[]
  workshops    Workshop[]
  customAlerts CustomAlert[] // 2.1.1 (Premium)
  yards        Yard[]       // 2.1 : gares de triage
  loans        Loan[]
  holdings     Shareholding[] @relation("Holder")
  shareholders Shareholding[] @relation("Issuer")
  sharePrices  SharePrice[]
  stockOrders  StockOrder[]
  sharePrice   Float    @default(0) // cours de référence, recalculé toutes les heures
  lastWeeklyReport String? // semaine (AAAA-MM-JJ du lundi, heure de Paris) du dernier rapport hebdo notifié
  lastDividendOn String?  // jour (AAAA-MM-JJ, heure de Paris) du dernier versement de dividendes
  wrecks       Wreck[]
  // 2.4 : le vrai coût du rail
  dieselTanks       Int       @default(0)  // cuves au dépôt (5 000 L chacune)
  dieselLiters      Float     @default(0)  // gazole en cuve
  dieselFixedPrice  Float?                 // contrat à prix fixe (prix au litre, frais compris)
  dieselFixedUntil  DateTime?
  powerFixedPrice   Float?                 // contrat d'électricité à prix fixe (au kWh)
  powerFixedUntil   DateTime?
  batteryKwh        Float     @default(0)  // courant stocké dans les batteries
  batteryOffPeak    Boolean   @default(true) // recharger les batteries aux heures creuses
  powerOfferPrice   Float?                 // prix auquel la compagnie vend son surplus aux autres joueurs
  co2Week           Float     @default(0)  // tonnes de CO₂ émises depuis lundi
  fuelBlocked       Boolean   @default(false) // facture d'énergie impayée : les rames thermiques attendent
  energyMeters      EnergyMeter[]
  carbonBills       CarbonBill[]
  powerPlants       PowerPlant[]
  partFactories     PartFactory[]
  concessions       Concession[]
}

// 2.4 : le vrai coût du rail.

// Réglages modifiables depuis le panneau d'administration (taux, période
// d'essai, état des marchés). Une ligne par clé, la valeur en JSON.
model GameSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Ce qu'une compagnie a consommé et émis, heure par heure. La facture
// d'énergie se règle à la fin de chaque heure ; les lignes servent aussi
// aux courbes de la page Énergie.
model EnergyMeter {
  id         String   @id @default(uuid())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  hour       DateTime // début de l'heure
  kwh        Float    @default(0) // consommé par les rames électriques
  liters     Float    @default(0) // gazole consommé
  produced   Float    @default(0) // produit par les centrales de la compagnie
  co2        Float    @default(0) // tonnes émises
  cost       Int      @default(0) // facture de l'heure (énergie seule)
  income     Int      @default(0) // courant revendu
  settled    Boolean  @default(false)
  trial      Boolean  @default(false) // facture calculée pendant la période d'essai, non prélevée

  @@unique([companyId, hour])
  @@index([hour, settled])
}

model CarbonBill {
  id         String   @id @default(uuid())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  week       String   // AAAA-MM-JJ du lundi (heure de Paris)
  emitted    Float
  quota      Float
  taxable    Float
  valuation  Int      // valeur de la compagnie au moment du calcul
  rate       Float    // prix moyen de la tonne, toutes tranches confondues
  amount     Int
  trial      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([companyId, week])
}

// Cours du gazole et du courant : la valeur du moment, et un relevé par heure.
model MarketIndex {
  kind       String   @id // DIESEL | POWER
  value      Float
  shock      Float    @default(1)
  shockUntil DateTime?
  shockLabel String?
  updatedAt  DateTime @updatedAt
}

model MarketIndexHistory {
  id    String   @id @default(uuid())
  kind  String
  value Float    // prix effectif (choc compris)
  at    DateTime @default(now())

  @@index([kind, at])
}

model PowerPlant {
  id        String   @id @default(uuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  kind      String   // SOLAIRE | EOLIEN | BARRAGE | BATTERIE
  station   String
  produced  Float    @default(0) // total produit depuis la construction
  builtAt   DateTime @default(now())

  @@index([companyId])
}

// Stock national de pièces détachées : le prix monte quand il baisse.
model PartMarket {
  part      String   @id // FREINS | BOGIES | MOTEUR | CAISSE
  stock     Int
  target    Int
  updatedAt DateTime @updatedAt
}

model PartFactory {
  id         String   @id @default(uuid())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  part       String
  station    String
  stored     Int      @default(0) // pièces sorties de l'usine, pas encore rangées ni vendues
  salePrice  Int?               // prix de vente aux autres joueurs (null = pas à vendre)
  producedAt DateTime @default(now()) // dernière pièce sortie
  builtAt    DateTime @default(now())

  @@index([companyId])
  @@index([part, salePrice])
}

// Une liaison entre deux gares voisines d'un itinéraire : son état, sa
// cagnotte de rénovation et, s'il y en a un, son concessionnaire.
model TrackSegment {
  key        String   @id // "A|B", gares triées
  condition  Float    @default(100)
  fund       Int      @default(0)
  round      Int      @default(0) // nombre de rénovations terminées
  renovatedAt DateTime?
  updatedAt  DateTime @updatedAt
  concession Concession?
  fundings   TrackFunding[]
}

model TrackFunding {
  id         String       @id @default(uuid())
  segment    TrackSegment @relation(fields: [segmentKey], references: [key], onDelete: Cascade)
  segmentKey String
  companyId  String
  amount     Int
  round      Int          @default(0) // numéro de la rénovation financée
  at         DateTime     @default(now())

  @@index([segmentKey, round])
  @@index([companyId, at])
}

model Concession {
  id             String       @id @default(uuid())
  segment        TrackSegment @relation(fields: [segmentKey], references: [key], onDelete: Cascade)
  segmentKey     String       @unique
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      String
  toll           Float        @default(0.05) // part de la recette des autres compagnies, de 0 à 0,15
  invested       Int
  pending        Int          @default(0) // péages encaissés pendant l'heure, versés d'un bloc
  totalTolls     Int          @default(0)
  lowSince       DateTime?    // état sous le seuil depuis…
  protectedUntil DateTime
  boughtAt       DateTime     @default(now())

  @@index([companyId])
}

// Un objet cosmétique acheté. Une ligne par objet et par compagnie : on ne
// vend chaque objet qu'une fois. La session Stripe sert de preuve de paiement
// et de garde contre un webhook livré deux fois.
model ShopPurchase {
  id              String   @id @default(uuid())
  itemId          String
  stripeSessionId String   @unique
  amountCents     Int
  purchasedAt     DateTime @default(now())
  giftFrom        String? // 2.0 : nom de la compagnie qui l'a offert
  revealedAt      DateTime? // 2.0 : l'animation de déballage a été vue

  company         Company  @relation(fields: [companyId], references: [id])
  companyId       String

  @@unique([companyId, itemId])
}

// Un appareil abonné aux notifications. Une compagnie peut en avoir plusieurs :
// le téléphone et l'ordinateur sont deux abonnements distincts, chacun avec ses
// propres clés de chiffrement. L'endpoint est l'identifiant unique côté
// navigateur — c'est lui qui sert de clé, pas l'appareil.
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
  companyId String

  @@index([companyId])
}

// ============================================================
// Cours du fret.
//
// Une seule ligne par marchandise, partagée par tout le réseau : le cours est
// une donnée de monde, pas de compagnie. Tout le monde voit le même prix au
// même moment, sinon spéculer n'aurait aucun sens collectif.
// ============================================================
model CargoMarket {
  cargoType String   @id // clé naturelle : le nom de la marchandise, déjà utilisé partout ailleurs
  basePrice Int      // valeur de référence d'une unité, autour de laquelle le cours oscille
  index     Float    @default(1) // multiplicateur courant, borné (voir market.service)
  history   String   @default("[]") // derniers relevés, JSON [{t,i}] — suffisant pour tracer une courbe
  eventLabel String? // événement en cours qui explique le mouvement, affiché tel quel au joueur
  eventUntil DateTime?
  updatedAt DateTime @updatedAt
}

// Entrepôt de la compagnie : ce qui permet de garder de la marchandise au lieu
// de la livrer tout de suite. Construit par chantier, agrandi par chantier.
model Warehouse {
  id        String   @id @default(uuid())
  capacity  Int      @default(20) // unités stockables, toutes marchandises confondues
  level     Int      @default(1)  // nombre d'agrandissements effectués, pilote le coût du suivant
  builtAt   DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
  companyId String   @unique
}

// Un lot en stock. Le prix d'achat moyen est conservé pour pouvoir afficher la
// plus ou moins-value : sans lui, le joueur ne sait pas s'il gagne de l'argent.
model StockLot {
  id           String   @id @default(uuid())
  cargoType    String
  quantity     Int
  avgUnitPrice Float    // moyenne pondérée des achats successifs

  company      Company  @relation(fields: [companyId], references: [id])
  companyId    String

  @@unique([companyId, cargoType])
}

// Chantier en cours. Une seule ligne active par compagnie : c'est la règle qui
// empêche une grosse trésorerie de se convertir instantanément en progression.
model Construction {
  id        String   @id @default(uuid())
  kind      String   // DEPOT | ENTREPOT | ENTREPOT_AGRANDISSEMENT
  label     String   // libellé figé à la commande, pour l'afficher sans le recalculer
  cost      Int      // déjà débité à la commande : on paie le chantier, pas la livraison
  startedAt DateTime @default(now())
  endsAt    DateTime
  done      Boolean  @default(false)
  queued    Boolean  @default(false) // en file (Premium) : démarre à la fin du chantier en cours
  durationMs Int     @default(0) // durée prévue, pour recaler endsAt au démarrage réel

  company   Company  @relation(fields: [companyId], references: [id])
  companyId String

  @@index([companyId, done])
}

// Alerte de cours (abonnés). Purement informative : elle ne fait rien d'autre
// que prévenir, donc elle enlève la surveillance, pas le travail.
model PriceAlert {
  id          String   @id @default(uuid())
  cargoType   String
  direction   String   // DESSOUS | DESSUS
  threshold   Float    // seuil exprimé en indice (1 = cours normal)
  triggeredAt DateTime?
  seen        Boolean  @default(false)
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String

  @@index([companyId])
}

// Ordre permanent (abonnés) : achète ou vend automatiquement au franchissement
// d'un seuil. Le prix obtenu est exactement celui qu'aurait eu un joueur
// présent — c'est la présence qui est remplacée, pas le rendement.
model StandingOrder {
  id         String   @id @default(uuid())
  cargoType  String
  kind       String   // ACHAT | VENTE
  threshold  Float
  quantity   Int
  active     Boolean  @default(true)
  lastRunAt  DateTime?
  createdAt  DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String

  @@index([companyId, active])
}

// Relation commerciale avec un donneur d'ordre. La réputation gagnée ici
// majore le tarif de TOUTES les cargaisons de ce client, pas seulement
// celles livrées dans le cadre d'une mission.
model ClientRelation {
  id         String   @id @default(uuid())
  clientId   String   // ACIERIES | PORT | COOPERATIVE | LABORATOIRES
  reputation Int      @default(0) // 0 à 100
  level      Int      @default(0) // palier atteint, pour ne le fêter qu'une fois

  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String

  @@unique([companyId, clientId])
}

// Un ordre daté proposé par un donneur d'ordre : le joueur l'accepte ou le refuse.
model Mission {
  id         String   @id @default(uuid())
  clientId   String
  cargoType  String   // marchandise demandée, tirée parmi celles du client
  target     Int      // nombre de cargaisons à livrer
  progress   Int      @default(0)
  reward     Int      // pièces versées à la réussite
  repReward  Int      // réputation gagnée chez ce client
  status     String   @default("PROPOSEE") // PROPOSEE | ACCEPTEE | REUSSIE | ECHOUEE
  offerUntil DateTime // au-delà, l'offre expire et le client en propose une autre
  dueAt      DateTime? // échéance de livraison, fixée à l'acceptation
  createdAt  DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String

  @@index([companyId, status])
}

model AdWatch {
  id        String   @id @default(uuid())
  date      String   // format "AAAA-MM-JJ", un enregistrement par jour et par compagnie
  count     Int      @default(0)

  company   Company  @relation(fields: [companyId], references: [id])
  companyId String

  @@unique([companyId, date])
}

model AchievementUnlock {
  id            String   @id @default(uuid())
  achievementId String   // identifiant du succès (ex. "coffres-pleins"), pas une relation, juste une clé fixe
  unlockedAt    DateTime @default(now())

  company       Company  @relation(fields: [companyId], references: [id])
  companyId     String

  @@unique([companyId, achievementId])
}

model Line {
  id                String   @id @default(uuid())
  name              String
  departureStation  String
  arrivalStation    String
  durationMinutes   Int      // temps de trajet simulé, en minutes (arrêts compris)
  // 1.7 : arrêts intermédiaires dans l'ordre, prix du billet (1 = prix normal), électrification
  stops             String[] @default([])
  priceRatio        Float    @default(1)
  electrified       Boolean  @default(false)
  doubleTrack       Boolean  @default(false) // 2.1 : double voie
  // 2.2 : ligne à grande vitesse. Date d'ouverture (chantier en cours tant
  // qu'elle est dans le futur), ce qu'elle a coûté, et l'ouverture déjà annoncée
  highSpeedAt       DateTime?
  highSpeedCost     Int      @default(0)
  highSpeedNotified Boolean  @default(false)
  autoPrice         Boolean  @default(false) // Premium : le prix se cale chaque heure sur le prix conseillé

  company           Company  @relation(fields: [companyId], references: [id])
  companyId         String

  trains            Train[]

  createdAt         DateTime @default(now())
  // concurrence (1.4) : dernier état connu, pour prévenir quand il change
  rivals            Int      @default(0)
  leading           Boolean  @default(true)
}

enum TrainStatus {
  IDLE          // à quai, disponible pour une ligne ou un contrat de fret
  EN_ROUTE      // en circulation (ligne voyageurs ou livraison de fret)
  MAINTENANCE   // indisponible
}

model Train {
  id           String      @id @default(uuid())
  name         String
  // 2.1.1 (Premium) : horaires de service de la rame, en heures de Paris (de serviceFrom à serviceTo, minuit possible)
  serviceFrom  Int?
  serviceTo    Int?
  model        String      @default("STANDARD") // STANDARD | EXPRESS | FRET_LOURD | COUCHETTES (1.6)
  status       TrainStatus @default(IDLE)

  // progression du trajet en cours (0 = départ, 100 = arrivé)
  progress     Int         @default(0)
  departedAt   DateTime?
  // usure du matériel (0 = neuf, 100 = en panne, nécessite réparation)
  wear         Int         @default(0)

  // 1.7 : sens de marche (0 = aller, 1 = retour), voitures ajoutées, dernier trajet
  direction      Int      @default(0)
  cars           String[] @default([])
  lastPassengers Int?
  lastSeats      Int?

  company      Company     @relation(fields: [companyId], references: [id])
  companyId    String

  line         Line?       @relation(fields: [lineId], references: [id])
  lineId       String?

  contracts    Contract[]
  // 2.1 : la plaque nominative (laiton, émail, bois)
  plateStyle   String?

  incidents    Incident[]

  purchasedAt  DateTime    @default(now())

  // 2.0 — l'atelier : état par organe, casse, pièces, révision programmée
  organs        Json?      // poids d'usure par organe { FREINS, BOGIES, MOTEUR, CAISSE } ; l'organe le plus chargé casse en premier
  brokenPart    String?    // organe cassé : la réparation demande la pièce
  partsEta      DateTime?  // pièce commandée, livrée à cette heure
  workshopUntil DateTime?  // en révision à l'atelier jusqu'à cette heure
  serviceAt     Int?       // révision automatique quand l'usure atteint ce seuil (40, 60, 80)

  // 2.0 — rame de collection, restaurée depuis une épave (numéro, histoire, livrée d'époque, prestige)
  heritage      Json?

  // 2.3 : rame publicitaire. La marque, sa couleur, et la fin du contrat
  adBrand       String?
  adColor       String?
  adUntil       DateTime?
}

// 2.0 : une épave près d'une gare. Libre (companyId nul) jusqu'à ce qu'une
// compagnie la rachète ; restaurée organe par organe ; trainId une fois remise en service.
model Wreck {
  id           String    @id @default(uuid())
  kind         String
  rarity       String
  station      String
  serial       String
  year         Int
  retiredYear  Int
  history      String
  damage       Json      // dégâts par organe, en %
  restored     String[]  @default([])
  working      String?   // organe en cours de restauration
  workUntil    DateTime?
  price        Int
  spent        Int       @default(0)
  discoveredAt DateTime  @default(now())
  expiresAt    DateTime
  company      Company?  @relation(fields: [companyId], references: [id])
  companyId    String?
  claimedAt    DateTime?
  trainId      String?
  completedAt  DateTime?

  @@index([companyId])
  @@index([expiresAt])
}

enum ContractStatus {
  DISPONIBLE  // offre sur le marché, pas encore prise
  EN_COURS    // acceptée, un train livre la marchandise
  LIVREE      // terminée, récompense versée
}

model Contract {
  id                String         @id @default(uuid())
  cargoType         String         // type de marchandise transportée
  originStation     String
  destinationStation String
  durationMinutes   Int            // temps de livraison simulé
  reward            Int            // récompense versée à la livraison
  risky             Boolean        @default(false) // marchandise fragile : récompense plus élevée mais risque de dommage
  insured           Boolean        @default(false) // prime payée à l'acceptation pour réduire le risque de dommage

  status            ContractStatus @default(DISPONIBLE)
  acceptedAt        DateTime?
  expiresAt         DateTime?      // au-delà, l'offre disparaît du marché si non acceptée

  company           Company?       @relation(fields: [companyId], references: [id])
  companyId         String?

  train             Train?         @relation(fields: [trainId], references: [id])
  trainId           String?
  // 2.1 : tournée de fret (plusieurs contrats sur une rame) et charge portée par les wagons
  tourMinutes       Int?
  loadFactor        Float          @default(1)
  // 2.3 : conteneur scellé. Son contenu n'est révélé qu'à la livraison
  sealed            Boolean        @default(false)
  sealedOutcome     String?

  createdAt         DateTime       @default(now())

  @@index([trainId])
}

model Incident {
  id          String   @id @default(uuid())
  message     String

  train       Train    @relation(fields: [trainId], references: [id])
  trainId     String

  createdAt   DateTime @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  type        String   // ACHAT_TRAIN | REPARATION | FRET | FONDATION | PERSONNEL | REVENU_LIGNE | PARRAINAGE | PUBLICITE
  amount      Int      // positif = recette, négatif = dépense
  description String
  // rame et ligne concernées, pour la rentabilité détaillée (sans clé étrangère :
  // une rame vendue ou une ligne supprimée ne doit pas effacer l'historique)
  trainId     String?
  lineId      String?

  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String

  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  // 2.1.2 : la table grandit à chaque arrivée ; succès, défis, résumé et
  // statistiques filtrent par type, et la lisaient en entier
  @@index([companyId, type, createdAt])
  @@index([type, createdAt])
}

model DailyChallenge {
  id        String   @id @default(uuid())
  date      String   // "YYYY-MM-DD", jour auquel ce défi appartient
  type      String   // LIVRAISONS | REPARATIONS | NOUVELLE_LIGNE
  target    Int
  reward    Int
  claimed   Boolean  @default(false)

  company   Company  @relation(fields: [companyId], references: [id])
  companyId String

  createdAt DateTime @default(now())

  @@unique([companyId, date])
}

model Staff {
  id             String   @id @default(uuid())
  role           String   // MECANICIEN | CHEF_DEPOT | DIRECTEUR_COMMERCIAL
  name           String   @default("")
  level          Int      @default(1)    // 1 à 5, accordé par le joueur à chaque augmentation
  xp             Int      @default(0)    // ticks de service : c'est l'ancienneté qui fait l'expérience
  raiseRequested Boolean  @default(false) // l'employé a atteint le niveau suivant et attend une réponse
  refusedAtXp    Int      @default(0)    // expérience au dernier refus, pour ne pas redemander aussitôt
  salaryPerTick  Int
  unpaidTicks    Int      @default(0)
  trainId        String?  // 2.0 : contrôleur ou conducteur affecté à une rame    // 1.7.2 : tours sans salaire ; l'employé part au bout d'une heure, plus au premier
  hiredAt        DateTime @default(now())

  company        Company  @relation(fields: [companyId], references: [id])
  companyId      String

  // plus d'unicité par poste : on peut désormais embaucher plusieurs mécaniciens
  @@index([companyId, role])
}

// 2.0 : la vraie météo de chaque gare (MET Norway), relevée toutes les 20 minutes
model StationWeather {
  station   String   @id
  kind      String   // CLAIR | NUAGEUX | PLUIE | ORAGE | NEIGE | VERGLAS | BROUILLARD | CANICULE
  symbol    String
  temp      Float
  wind      Float
  isDay     Boolean  @default(true)
  updatedAt DateTime
}

// 1.4 à 1.7 : épisodes météo inventés, sur tout le réseau. Plus créés depuis la 2.0.
model WeatherEvent {
  id        String   @id @default(uuid())
  type      String   // BROUILLARD | CANICULE | VERGLAS | NEIGE (hiver seulement)
  startedAt DateTime @default(now())
  endsAt    DateTime
}

// Événement de gare (1.4) : salon, festival, grève… Modifie la demande d'une
// gare pendant quelques heures, pour tout le réseau. Annoncé une heure avant
// son début (visible des abonnés).
model StationEvent {
  id         String   @id @default(uuid())
  station    String
  label      String
  multiplier Float
  startsAt   DateTime @default(now())
  endsAt     DateTime
  createdAt  DateTime @default(now())

  @@index([endsAt])
}

// Appel d'offres (1.5) : chaque semaine, des régions cherchent une compagnie
// pour exploiter une liaison. Offres sous pli fermé du lundi au mercredi, puis
// la moins-disante (pondérée par la réputation) touche une subvention jusqu'au
// lundi suivant, à condition de faire rouler ses rames sur la liaison.
model Tender {
  id            String   @id @default(uuid())
  weekStart     DateTime // lundi 0 h (Paris) de la semaine du marché
  region        String
  stationA      String
  stationB      String
  budgetPerDay  Int      // plafond de subvention par jour
  tripsRequired Int      // trajets à effectuer sur la durée du contrat
  publishedAt   DateTime // visible des abonnés à partir d'ici
  opensAt       DateTime // offres acceptées à partir d'ici
  closesAt      DateTime // attribution, et début du contrat
  endsAt        DateTime // fin du contrat
  status        String   @default("ANNONCE") // ANNONCE | OUVERT | ATTRIBUE | INFRUCTUEUX | TERMINE
  winnerId      String?
  winningBid    Int?     // subvention par jour obtenue
  activeTicks   Int      @default(0) // tours où une rame du titulaire roulait sur la liaison
  paidTicks     Int      @default(0)
  paidTotal     Int      @default(0)
  trips         Int      @default(0) // trajets comptés à la clôture
  objectiveMet  Boolean?
  createdAt     DateTime @default(now())

  bids          TenderBid[]

  @@unique([weekStart, stationA, stationB])
  @@index([status])
  @@index([weekStart])
}

model TenderBid {
  id        String   @id @default(uuid())
  amount    Int      // subvention demandée par jour
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  tenderId  String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@unique([tenderId, companyId])
}

// Décision (1.6) : une situation posée au directeur, avec deux ou trois
// réponses et une échéance. Sans réponse, la réponse par défaut s'applique.
// Certaines laissent un effet pour quelques heures (grève, tarifs) ou un
// objectif à tenir (la ligne promise au maire).
model Decision {
  id              String    @id @default(uuid())
  kind            String    // GREVE | FISSURE | FESTIVAL | MAIRE | PRESSE | RIVAL | METEO | VIP | OCCASION | TOURISME | TRAVAUX
  title           String
  body            String
  place           String?
  data            Json?     // contexte figé à la création : rame, gare, montants
  choices         Json      // [{ id, label, effects: [{ text, tone }] }]
  defaultChoiceId String
  status          String    @default("OUVERTE") // OUVERTE | TRANCHEE | EXPIREE
  chosenId        String?
  outcome         String?
  // effet sur la recette : une gare, ou une liaison « A|B »
  effectKey        String?
  effectMultiplier Float?
  effectEndsAt     DateTime?
  // objectif : une ligne vers cette gare avant l'échéance, contre une prime
  goalStation     String?
  goalReward      Int?
  goalDeadline    DateTime?
  goalDone        Boolean   @default(false)

  company         Company   @relation(fields: [companyId], references: [id])
  companyId       String

  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  resolvedAt      DateTime?

  @@index([companyId, status])
  @@index([status, expiresAt])
  @@index([effectEndsAt])
}


// ============================================================
// 1.7 — Infrastructures
// ============================================================

// Une gare achetée. Un seul propriétaire par gare : les autres compagnies qui
// s'y arrêtent lui versent une redevance de quai, et tous les voyageurs qui y
// passent font vivre ses commerces. Rachetable par un concurrent (au prix fort)
// une fois la période de protection passée.
model StationOwnership {
  station        String   @id
  level          Int      @default(1) // 1 à 3 : taille des commerces
  invested       Int      // prix d'achat + agrandissements, base du rachat
  protectedUntil DateTime
  pendingFees    Int      @default(0) // redevances de quai en attente de versement (versées toutes les heures)
  pendingShops   Int      @default(0) // recettes des commerces en attente de versement
  totalFees      Int      @default(0)
  totalShops     Int      @default(0)
  boughtAt       DateTime @default(now())
  protectionNotified Boolean @default(false) // Premium : fin de protection déjà signalée

  company        Company  @relation(fields: [companyId], references: [id])
  companyId      String
}

// 2.1.1 (Premium) : alerte personnalisée — TRESORERIE, USURE, FRET, REVENTE, avec son seuil
model CustomAlert {
  id        String    @id @default(uuid())
  kind      String
  threshold Float
  targetId  String?   // la rame visée (REVENTE)
  active    Boolean   @default(false) // la condition est vraie en ce moment (déclenchement sur front montant)
  lastKey   String?   // ce qui l'a déclenchée (rames, contrat) : un changement la redéclenche
  firedAt   DateTime?
  message   String?
  createdAt DateTime  @default(now())

  company   Company   @relation(fields: [companyId], references: [id])
  companyId String

  @@index([companyId])
}

// 2.1 : gare de triage — le fret qui en part ou y arrive est trié plus vite et payé un peu plus
model Yard {
  id        String   @id @default(uuid())
  station   String
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
  companyId String

  @@unique([companyId, station])
}

// Un atelier régional : les rames qui desservent sa gare s'usent moins.
model Workshop {
  id        String   @id @default(uuid())
  station   String
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
  companyId String

  @@unique([companyId, station])
}

// ============================================================
// 1.7 — Finances
// ============================================================

// Un emprunt bancaire, remboursé automatiquement par mensualités horaires.
model Loan {
  id          String    @id @default(uuid())
  principal   Int
  ratePct     Float     // intérêt total sur la durée, en %
  totalDue    Int       // principal + intérêts
  remaining   Int
  hours       Int       // durée, en heures
  missed      Int       @default(0) // échéances impayées
  createdAt   DateTime  @default(now())
  lastPaidAt  DateTime  @default(now())
  closedAt    DateTime?
  warnedAt    DateTime? // Premium : alerte « trésorerie trop basse pour l'échéance » déjà envoyée

  company     Company   @relation(fields: [companyId], references: [id])
  companyId   String

  @@index([companyId, closedAt])
}

// Actions d'une compagnie détenues par une autre.
model Shareholding {
  id        String  @id @default(uuid())
  shares    Int
  invested  Int     // pièces dépensées (frais compris), pour la plus-value

  holder    Company @relation("Holder", fields: [holderId], references: [id])
  holderId  String
  issuer    Company @relation("Issuer", fields: [issuerId], references: [id])
  issuerId  String

  @@unique([holderId, issuerId])
  @@index([issuerId])
}

// Historique horaire du cours d'une compagnie.
model SharePrice {
  id        String   @id @default(uuid())
  price     Float
  at        DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
  companyId String

  @@index([companyId, at])
}

// Premium : un ordre de bourse à cours limite, exécuté par la simulation.
model StockOrder {
  id         String   @id @default(uuid())
  issuerId   String
  side       String   // BUY | SELL
  shares     Int
  limitPrice Float
  createdAt  DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String

  @@index([companyId])
}

// Remplissage d'une ligne heure par heure (48 h gardées), pour la courbe Premium.
model LineLoadHour {
  id         String   @id @default(uuid())
  lineId     String
  companyId  String
  hour       DateTime // début de l'heure
  trips      Int      @default(0)
  passengers Int      @default(0)
  seats      Int      @default(0)
  left       Int      @default(0)

  @@unique([lineId, hour])
  @@index([companyId, hour])
}


// ============================================================
// 2.0 — Saisons
// ============================================================

// Une saison de quatre semaines. Le classement de saison repart à zéro ;
// la compagnie, elle, garde tout.
model Season {
  id        String   @id @default(uuid())
  number    Int      @unique
  name      String
  startsAt  DateTime
  endsAt    DateTime
  endedAt   DateTime?
  createdAt DateTime @default(now())
}

// La place d'une compagnie dans une saison : sa division, son groupe de
// douze, ses points.
model SeasonEntry {
  id           String   @id @default(uuid())
  seasonId     String
  companyId    String
  division     Int      // 0 Bronze, 1 Argent, 2 Or, 3 Platine
  groupNo      Int
  points       Int      @default(0)
  rankYesterday Int?    // pour la flèche d'évolution sur 24 h
  finalRank    Int?
  outcome      String?  // MONTEE, MAINTIEN, DESCENTE
  rewarded     Boolean  @default(false)
  joinedAt     DateTime @default(now())

  @@unique([seasonId, companyId])
  @@index([seasonId, division, groupNo])
}

// La progression d'une compagnie sur un objectif de la semaine.
model SeasonObjectiveProgress {
  id        String   @id @default(uuid())
  seasonId  String
  week      Int
  kind      String
  companyId String
  progress  Int      @default(0)
  doneAt    DateTime?

  @@unique([seasonId, week, kind, companyId])
}

// ============================================================
// 2.0 — Alliances
// ============================================================

model Alliance {
  id         String   @id @default(uuid())
  name       String   @unique
  color      String   @default("#f59e0b")
  discordUrl String?
  founderId  String
  createdAt  DateTime @default(now())
  // 2.0.2 : candidatures
  recruiting Boolean  @default(true)
  pitch      String?
  // 2.1 : la livrée commune, posée par un membre qui possède le coffret d'alliance
  livery     String?
}

model AllianceMember {
  id         String   @id @default(uuid())
  allianceId String
  companyId  String   @unique
  joinedAt   DateTime @default(now())
  viaApplication Boolean @default(false)

  @@index([allianceId])
}

// 2.0.2 : une compagnie sans alliance postule, le fondateur accepte ou refuse
model AllianceApplication {
  id         String   @id @default(uuid())
  allianceId String
  companyId  String
  message    String   @default("")
  createdAt  DateTime @default(now())

  @@unique([allianceId, companyId])
  @@index([companyId])
}

model AllianceInvite {
  id         String   @id @default(uuid())
  allianceId String
  companyId  String
  createdAt  DateTime @default(now())

  @@unique([allianceId, companyId])
}

// Le tableau d'affichage : messages courts, gardés sept jours.
// 2.3 : les objectifs d'alliance de la semaine. Une ligne par alliance et par
// semaine (lundi 0 h, heure de Paris). Les objectifs sont figés au tirage, avec
// leur cible ; la progression et les réussites sont recalculées depuis la base.
model AllianceWeek {
  id         String   @id @default(uuid())
  allianceId String
  weekStart  DateTime
  objectives Json     // [{ kind, label, target, points, coins }]
  baseline   Json     @default("{}") // point de départ des objectifs « de stock » (gares communes)
  progress   Json     @default("{}") // { kind: total }
  shares     Json     @default("{}") // { kind: { companyId: part } }
  done       Json     @default("{}") // { kind: date de réussite }
  bonusPaid  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([allianceId, weekStart])
  @@index([weekStart])
}

// 2.3 : régions d'alliance. Chaque lundi, une ligne par région : l'alliance
// qui la tient pour la semaine (ou personne), ce qui l'a départagée, et depuis
// quand elle la tient sans interruption.
model RegionControl {
  id         String   @id @default(uuid())
  weekStart  DateTime
  region     String
  allianceId String?
  stations   Int      @default(0) // gares desservies par l'alliance dans la région
  trips      Int      @default(0) // trajets de la semaine passée dans la région (départage)
  since      DateTime? // première semaine de la série en cours
  previousId String?  // alliance qui la tenait la semaine d'avant
  createdAt  DateTime @default(now())

  @@unique([weekStart, region])
  @@index([allianceId])
}

model AllianceMessage {
  id         String   @id @default(uuid())
  allianceId String
  companyId  String
  text       String
  createdAt  DateTime @default(now())

  @@index([allianceId, createdAt])
}

// ============================================================
// 2.0 — Le Grand Chantier
// ============================================================

// Un objectif commun à tout le serveur : chaque trajet le fait avancer.
model WorldProject {
  id          String    @id
  name        String
  target      Int
  progress    Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model WorldContribution {
  id        String @id @default(uuid())
  projectId String
  companyId String
  amount    Int    @default(0)

  @@unique([projectId, companyId])
}

// 1.7.2 : un seul serveur fait tourner la simulation. Pendant un déploiement,
// l'ancien et le nouveau conteneur cohabitent quelques instants ; sans ce bail,
// les deux jouaient chaque tour (double paie, double entretien).
model SimLease {
  id     Int      @id
  holder String
  until  DateTime
}

// 2.0 : les suites d'une décision. Un choix peut avoir une conséquence
// quelques heures plus tard : une nouvelle décision, ou un effet direct.
model DecisionFollowUp {
  id        String   @id @default(uuid())
  companyId String
  kind      String   // clé d'une suite (voir decision.service)
  data      Json?
  dueAt     DateTime
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([done, dueAt])
}

// 2.0 : pièces du parcours gratuit du Pass de saison, déjà réclamées
model SeasonPassClaim {
  id        String   @id @default(uuid())
  seasonId  String
  companyId String
  tier      Int
  createdAt DateTime @default(now())

  @@unique([seasonId, companyId, tier])
}

// 2.1 : messages publiés par le bot Discord. La clé dit de quoi il s'agit
// ("classement", "patch:2.1.0", "saison-fin:3", "chantier:50"…) : un message
// déjà publié ne l'est pas deux fois, même après un redéploiement, et le
// message du classement est modifié sur place plutôt que republié.
model DiscordPost {
  key       String   @id
  channelId String
  messageId String
  createdAt DateTime @default(now())
}

// 2.1 : giveaways du serveur Discord (commande /giveaway). Le lot est livré
// dans le jeu au tirage : des pièces ou une exclusivité Discord.
model Giveaway {
  id         String    @id @default(uuid())
  channelId  String
  messageId  String    @default("")
  prizeKind  String    // pieces | objet
  prizeValue String    // montant, ou identifiant de l'objet
  winners    Int       @default(1)
  endsAt     DateTime
  endedAt    DateTime?
  createdBy  String    // identifiant Discord du membre du staff
  winnerIds  String[]  @default([])
  createdAt  DateTime  @default(now())

  @@index([endedAt, endsAt])
}

model GiveawayEntry {
  id         String   @id @default(uuid())
  giveawayId String
  discordId  String
  createdAt  DateTime @default(now())

  @@unique([giveawayId, discordId])
}

// 2.1.2 : le Train des 200. Un trajet unique de 48 h par toutes les gares
// desservies ; chaque compagnie chez qui il passe touche une prime et son
// nom est peint sur ses voitures.
model SpecialTrain {
  id        String   @id
  startsAt  DateTime
  endsAt    DateTime
  route     Json // [{ station, at }]
  lastStop  Int      @default(-1)
  createdAt DateTime @default(now())
}

model SpecialTrainVisit {
  id        String   @id @default(uuid())
  trainId   String
  companyId String
  station   String
  reward    Int
  at        DateTime @default(now())

  @@unique([trainId, companyId])
  @@index([trainId, at])
}

// 2.2 : Halloween. Les âmes récoltées par une compagnie pendant l'édition
// d'une année (le Train fantôme hante une gare, voir halloween.service).
model HalloweenSoul {
  id        String   @id @default(uuid())
  year      Int
  companyId String
  souls     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([year, companyId])
  @@index([year, souls])
}

// ============================================================
// 2.2 — Panneau d'administration
// ============================================================

// Tout ce que fait un admin depuis le panneau : qui, quoi, sur qui.
model AdminAction {
  id        String   @id @default(uuid())
  adminId   String   // User.id de l'admin
  adminName String
  action    String   // ARGENT | PREMIUM | OBJET | BAN | RENOMMER | ALLIANCE | SAISON | CHANTIER | ANNONCE | GIVEAWAY
  targetId  String?  // compagnie, alliance, saison…
  target    String?  // libellé lisible, figé au moment de l'action
  details   String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetId])
}

// Une annonce rédigée dans le panneau : publiée sur Discord, et son texte
// Instagram préparé à côté (publication à la main).
model Announcement {
  id          String   @id @default(uuid())
  title       String
  body        String
  imageUrl    String?
  channel     String   // ANNONCES | PATCH_NOTES | SAISONS | CHANTIER
  ping        String?  // MAJ | EVENEMENTS
  igCaption   String   @default("")
  discordKey  String?  // clé DiscordPost, null si non publiée sur Discord
  pushSent    Int      @default(0)
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
