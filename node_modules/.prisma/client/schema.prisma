generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  pseudo    String
  password  String
  createdAt DateTime @default(now())

  company Company?
}

model Company {
  id          String   @id @default(uuid())
  name        String
  liveryColor String   @default("#f2a900")
  balance     Int      @default(500) // trésorerie, en pièces
  maxTrains   Int      @default(2) // capacité du dépôt, extensible contre paiement
  isPremium   Boolean  @default(false) // débloque les modèles de trains exclusifs
  createdAt   DateTime @default(now())

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String @unique

  trains          Train[]
  lines           Line[]
  contracts       Contract[]
  transactions    Transaction[]
  dailyChallenges DailyChallenge[]
  staff           Staff[]
}

model Line {
  id               String @id @default(uuid())
  name             String
  departureStation String
  arrivalStation   String
  durationMinutes  Int // temps de trajet simulé, en minutes

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  trains Train[]

  createdAt DateTime @default(now())
}

enum TrainStatus {
  IDLE // à quai, disponible pour une ligne ou un contrat de fret
  EN_ROUTE // en circulation (ligne voyageurs ou livraison de fret)
  MAINTENANCE // indisponible
}

model Train {
  id     String      @id @default(uuid())
  name   String
  model  String      @default("STANDARD") // STANDARD | EXPRESS | FRET_LOURD (Premium)
  status TrainStatus @default(IDLE)

  // progression du trajet en cours (0 = départ, 100 = arrivé)
  progress   Int       @default(0)
  departedAt DateTime?

  // usure du matériel (0 = neuf, 100 = en panne, nécessite réparation)
  wear Int @default(0)

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  line   Line?   @relation(fields: [lineId], references: [id])
  lineId String?

  contract Contract?

  incidents Incident[]

  purchasedAt DateTime @default(now())
}

enum ContractStatus {
  DISPONIBLE // offre sur le marché, pas encore prise
  EN_COURS // acceptée, un train livre la marchandise
  LIVREE // terminée, récompense versée
}

model Contract {
  id                 String  @id @default(uuid())
  cargoType          String // type de marchandise transportée
  originStation      String
  destinationStation String
  durationMinutes    Int // temps de livraison simulé
  reward             Int // récompense versée à la livraison
  risky              Boolean @default(false) // marchandise fragile : récompense plus élevée mais risque de dommage

  status     ContractStatus @default(DISPONIBLE)
  acceptedAt DateTime?
  expiresAt  DateTime? // au-delà, l'offre disparaît du marché si non acceptée

  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  train   Train?  @relation(fields: [trainId], references: [id])
  trainId String? @unique

  createdAt DateTime @default(now())
}

model Incident {
  id      String @id @default(uuid())
  message String

  train   Train  @relation(fields: [trainId], references: [id])
  trainId String

  createdAt DateTime @default(now())
}

model Transaction {
  id          String @id @default(uuid())
  type        String // ACHAT_TRAIN | REPARATION | FRET | FONDATION
  amount      Int // positif = recette, négatif = dépense
  description String

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  createdAt DateTime @default(now())
}

model DailyChallenge {
  id      String  @id @default(uuid())
  date    String // "YYYY-MM-DD", jour auquel ce défi appartient
  type    String // LIVRAISONS | REPARATIONS | NOUVELLE_LIGNE
  target  Int
  reward  Int
  claimed Boolean @default(false)

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  createdAt DateTime @default(now())

  @@unique([companyId, date])
}

model Staff {
  id            String   @id @default(uuid())
  role          String // MECANICIEN | CHEF_DEPOT
  salaryPerTick Int
  hiredAt       DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  @@unique([companyId, role])
}

model WeatherEvent {
  id        String   @id @default(uuid())
  type      String // BROUILLARD | CANICULE | VERGLAS
  startedAt DateTime @default(now())
  endsAt    DateTime
}
