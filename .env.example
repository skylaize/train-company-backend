# Connexion utilisée par le jeu. En production (Neon), c'est l'adresse avec
# "-pooler" dans le nom d'hôte : le connecteur mutualisé encaisse les requêtes
# courtes et nombreuses de la simulation.
DATABASE_URL="postgresql://app_reseau:vbGpZlIVBJHR8Mgq@141.94.16.41:5432/prod_bdd?sslmode=disable"

# Connexion utilisée UNIQUEMENT par les migrations : la même base, sans le
# pooler. Le moteur de migration a besoin d'une vraie session, que PgBouncer en
# mode transaction ne sait pas tenir — à travers le pooler, "migrate deploy"
# expire en P1002. En local, mettez simplement la même valeur que ci-dessus.
DIRECT_DATABASE_URL="postgresql://app_reseau:vbGpZlIVBJHR8Mgq@141.94.16.41:5432/prod_bdd?sslmode=disable"

JWT_SECRET="change-moi-en-une-longue-chaine-aleatoire"
PORT=4000

# Vente du statut Premium. Tant que les trois clés Stripe ne sont pas
# renseignées, la vente reste fermée et l'interface affiche « Bientôt
# disponible » plutôt qu'un bouton qui échouerait.
STRIPE_SECRET_KEY=""
STRIPE_PREMIUM_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
PUBLIC_SITE_URL="https://compagnie.skhost.fr"

# ---- Écran de connexion (1.6) : chaque bloc est facultatif ----
# Adresse publique de l'API (sert d'adresse de retour à Discord et Google)
API_PUBLIC_URL="https://api.exemple.fr"

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile) : les deux clés, ou aucune
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Connexion avec Discord (discord.com/developers > OAuth2)
# Adresse de redirection à déclarer : {API_PUBLIC_URL}/api/auth/oauth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Connexion avec Google (console.cloud.google.com > Identifiants > ID client OAuth)
# Adresse de redirection à déclarer : {API_PUBLIC_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mot de passe oublié : envoi d'e-mails
SMTP_URL=""   # ex. smtps://identifiant:motdepasse@smtp-relay.brevo.com:465
MAIL_FROM="Réseau <no-reply@compagnie.skhost.fr>"
