# Connexion utilisée par le jeu. En production (Neon), c'est l'adresse avec
# "-pooler" dans le nom d'hôte : le connecteur mutualisé encaisse les requêtes
# courtes et nombreuses de la simulation.
DATABASE_URL="postgresql://USER:MOTDEPASSE@localhost:5432/train_company?schema=public"

# Connexion utilisée UNIQUEMENT par les migrations : la même base, sans le
# pooler. Le moteur de migration a besoin d'une vraie session, que PgBouncer en
# mode transaction ne sait pas tenir — à travers le pooler, "migrate deploy"
# expire en P1002. En local, mettez simplement la même valeur que ci-dessus.
DIRECT_DATABASE_URL="postgresql://USER:MOTDEPASSE@localhost:5432/train_company?schema=public"

JWT_SECRET="change-moi-en-une-longue-chaine-aleatoire"
PORT=4000

# Vente du statut Premium. Tant que les trois clés Stripe ne sont pas
# renseignées, la vente reste fermée et l'interface affiche « Bientôt
# disponible » plutôt qu'un bouton qui échouerait.
STRIPE_SECRET_KEY=""
STRIPE_PREMIUM_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
PUBLIC_SITE_URL="https://compagnie.skhost.fr"
